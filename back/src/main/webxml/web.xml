<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- TanStack Router maneja rutas como /productos y /facturas del lado del navegador,
         nunca existen como archivos reales en el WAR. Si el usuario refresca la pagina (F5)
         estando en /HelloJakarta-variante/productos, el navegador le pide ese path
         DIRECTO al servidor, y GlassFish no tiene ningun archivo ahi, solo index.html,
         /assets/* y /api/*. Sin esto, eso daria 404. Con esto, cualquier 404 cae de vuelta
         a index.html, y ahi React + el router vuelven a arrancar y leen la URL para
         mostrar la pagina correcta. -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.html</location>
    </error-page>

</web-app>
